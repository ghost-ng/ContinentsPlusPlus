<?xml version="1.0" encoding="utf-8"?>
<Mod id="ContinentsPlusPlus" version="1.4.1"
	xmlns="ModInfo">
	<Properties>
		<Name>LOC_CONTINENTS_PLUS_PLUS_NAME</Name>
		<Description>LOC_CONTINENTS_PLUS_PLUS_DESCRIPTION</Description>
		<Authors>ghost-ng</Authors>
		<Package>MOD</Package>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="Base Standard"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
		<Criteria id="continents-plus-plus-map">
			<MapInUse>{ContinentsPlusPlus}modules/maps/continents-plus-plus.js</MapInUse>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Game scope: Only loads when Continents++ map is selected -->
		<ActionGroup id="base-game-main-mapscript-template" scope="game" criteria="continents-plus-plus-map">
			<Actions>
				<UpdateText>
					<Item>modules/text/en_us/MapText.xml</Item>
					<Item>modules/text/en_us/ContinentNamesText.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>modules/config/game-config.xml</Item>
					<Item>modules/config/AI_Naval_Override.xml</Item>
					<Item>modules/config/ContinentNames.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<!-- Shell scope: Always loads so map appears in picker -->
		<ActionGroup id="shell-mapscript-template" scope="shell" criteria="always">
			<Actions>
				<UpdateText>
					<Item>modules/text/en_us/MapText.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>modules/config/config.xml</Item>
					<Item>modules/config/map-options.xml</Item>
				</UpdateDatabase>
				<UIScripts>
					<Item>ui/shell/cpp-map-tile-icon.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/icons/continents_plus_plus_map_icon.png</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>modules/text/en_us/ModuleText.xml</File>
		<File>modules/text/en_us/MapText.xml</File>
		<File>modules/text/en_us/ContinentNamesText.xml</File>
	</LocalizedText>
	<ScriptModules>
		<Module path="modules/maps/continents-plus-plus.js" />
	</ScriptModules>
</Mod>
